{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-enquiry-tracker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: `wrangler deploy` creates/reuses a D1 database called
  // "wedding-enquiries" in whichever Cloudflare account deploys this.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wedding-enquiries",
      "migrations_dir": "migrations"
    }
  ],
  // The .sql schema is bundled so the Worker can create its tables on first use.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "observability": { "enabled": true }
}
